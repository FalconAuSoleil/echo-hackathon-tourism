{
  "name": "@echo/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Echo offline-first PWA: on-device Whisper + sentence similarity (transformers.js in a Web Worker)",
  "scripts": {
    "assets": "tsx scripts/prepare-assets.ts",
    "dev": "tsx scripts/prepare-assets.ts && vite",
    "build": "tsx scripts/prepare-assets.ts && vite build",
    "preview": "vite preview",
    "icons": "tsx scripts/make-icons.ts",
    "e2e": "tsx scripts/e2e.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/network": "^8.0.1",
    "@echo/core": "workspace:*",
    "@echo/models": "workspace:*",
    "@huggingface/transformers": "^4.3.0",
    "idb": "^8.0.3",
    "preact": "^10.27.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
